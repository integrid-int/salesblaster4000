# Required in production. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Microsoft Entra ID, Integrid tenant only.
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=
# Optional. Defaults to https://login.microsoftonline.com/<tenant>/v2.0
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# Comma-separated. Everyone else who signs in is a seller.
QUOTEWRIGHT_ADMIN_EMAILS=ryan@integrid.net

# Postgres connection string. Leave unset to use a local PGlite database in .data/pglite.
DATABASE_URL=

# Vercel Cron sends Authorization: Bearer $CRON_SECRET
CRON_SECRET=

# Local only. Never set this in production.
# Enables an @integrid.net email form and sample Halo cache rows.
AUTH_DEV_BYPASS=
